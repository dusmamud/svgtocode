---
import ThemeToggle from './ThemeToggle';
import { LOCALES, LOCALE_NAMES, type Dict } from '../i18n/ui';

interface Props {
  locale: string;
  t: Dict;
  /** Sub-page slug when this header is used on a content page ('about' | 'how-it-works' | 'privacy'). */
  path?: string;
  /** Tool slug when used on a tool landing page (marks the current tool). */
  activeTool?: string;
}

const { locale, t, path, activeTool } = Astro.props;
const themeLabels = { light: t.themeLight, dark: t.themeDark, system: t.themeSystem, label: t.themeLabel };

const TOOLS = [
  { slug: 'svg-to-jsx', label: 'SVG → JSX', desc: t.toolJsxDesc },
  { slug: 'svg-to-react', label: 'SVG → React', desc: t.toolReactDesc },
  { slug: 'svg-to-base64', label: 'SVG → Base64', desc: t.toolBase64Desc },
  { slug: 'svg-to-data-uri', label: 'SVG → Data URI', desc: t.toolDataUriDesc },
  { slug: 'svg-optimizer', label: 'SVG Optimizer', desc: t.toolOptimizerDesc },
  { slug: 'svg-to-png', label: 'SVG → PNG', desc: t.toolPngDesc },
];

const homeHref = locale === 'en' ? '/' : `/${locale}/`;
const pageHref = (p: string) => (locale === 'en' ? `/${p}` : `/${locale}/${p}`);
/* Language switching stays on the same page (home or the current sub-page). */
const localeUrl = (l: string) => (l === 'en' ? '/' : `/${l}/`) + (path ? `${path}/` : '');
---

<header class="border-b border-border bg-surface">
  <div class="mx-auto flex h-[60px] max-w-6xl items-center gap-2 px-4">
    <a href={homeHref} class="flex min-w-0 shrink-0 items-center gap-2.5 rounded-lg transition-opacity hover:opacity-80" aria-label={t.brandHome}>
      <svg width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="var(--accent)" />
        <path d="M9 21 L16 8 L23 21" stroke="var(--accent-ink)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none" />
        <path d="M12.5 21 h7" stroke="var(--accent-ink)" stroke-width="2.6" stroke-linecap="round" />
        <circle cx="16" cy="24.5" r="1.6" fill="var(--accent-ink)" />
      </svg>
      <span class="truncate text-[17px] font-bold tracking-tight">VectorForge</span>
    </a>
    <nav class="ms-8 hidden lg:block" aria-label="Primary">
      <ul class="flex items-center gap-1">
        <li class="relative">
          <button
            id="nav-tools-toggle"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="nav-tools-menu"
            class="inline-flex min-h-[44px] items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium text-muted transition-colors hover:bg-surface-2 hover:text-text"
          >
            {t.navTools}
            <svg id="nav-tools-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <ul
            id="nav-tools-menu"
            class="absolute start-0 top-full z-50 mt-2 hidden w-80 rounded-2xl border border-border bg-surface p-2 shadow-xl"
          >
            {TOOLS.map((x) => (
              <li>
                <a
                  href={`/${x.slug}/`}
                  aria-current={x.slug === activeTool ? 'page' : undefined}
                  class="flex min-h-[44px] flex-col justify-center rounded-xl px-3 py-2.5 transition-colors hover:bg-surface-2"
                >
                  <span class="text-sm font-semibold">{x.label}</span>
                  <span class="text-xs text-muted">{x.desc}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
        <li>
          <a href={pageHref('how-it-works')} aria-current={path === 'how-it-works' ? 'page' : undefined} class="inline-flex min-h-[44px] items-center rounded-lg px-3 py-2 text-sm font-medium text-muted transition-colors hover:bg-surface-2 hover:text-text">{t.navHowItWorks}</a>
        </li>
        <li>
          <a href={pageHref('about')} aria-current={path === 'about' ? 'page' : undefined} class="inline-flex min-h-[44px] items-center rounded-lg px-3 py-2 text-sm font-medium text-muted transition-colors hover:bg-surface-2 hover:text-text">{t.navAbout}</a>
        </li>
        <li>
          <a href={pageHref('privacy')} aria-current={path === 'privacy' ? 'page' : undefined} class="inline-flex min-h-[44px] items-center rounded-lg px-3 py-2 text-sm font-medium text-muted transition-colors hover:bg-surface-2 hover:text-text">{t.navPrivacy}</a>
        </li>
      </ul>
    </nav>
    <div class="ms-auto flex items-center gap-2">
      <label class="sr-only" for="locale-select">{t.languageLabel}</label>
      <select
        id="locale-select"
        data-locale-select
        aria-label={t.languageLabel}
        class="hidden h-10 cursor-pointer rounded-full border border-border bg-surface px-3 text-sm font-medium text-text lg:block"
        data-current={locale}
      >
        {LOCALES.map((l) => (
          <option value={localeUrl(l)} selected={l === locale}>
            {LOCALE_NAMES[l]}
          </option>
        ))}
      </select>
      <a
        href="https://github.com/dusmamud/svgtocode"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub"
        class="hidden h-10 w-10 shrink-0 place-items-center rounded-full border border-border text-text transition-colors hover:bg-surface-2 lg:grid"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
      </a>
      <ThemeToggle labels={themeLabels} client:load />
      <button
        id="nav-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border text-text transition-colors hover:bg-surface-2 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menu"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="fixed inset-0 z-[60] hidden flex-col bg-surface lg:hidden" role="dialog" aria-modal="true">
    <div class="flex h-[60px] shrink-0 items-center gap-2 px-4">
      <a href={homeHref} class="flex min-w-0 shrink-0 items-center gap-2.5 rounded-lg" aria-label={t.brandHome}>
        <svg width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect width="32" height="32" rx="8" fill="var(--accent)" />
          <path d="M9 21 L16 8 L23 21" stroke="var(--accent-ink)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          <path d="M12.5 21 h7" stroke="var(--accent-ink)" stroke-width="2.6" stroke-linecap="round" />
          <circle cx="16" cy="24.5" r="1.6" fill="var(--accent-ink)" />
        </svg>
        <span class="truncate text-[17px] font-bold tracking-tight">VectorForge</span>
      </a>
      <div class="ms-auto">
        <button id="mobile-menu-close" type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border text-text transition-colors hover:bg-surface-2" aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>
    <nav class="flex-1 overflow-y-auto px-4 pb-[max(2rem,env(safe-area-inset-bottom))]" aria-label="Mobile">
      <ul class="divide-y divide-border/70">
        <li>
          <p class="px-2 pb-1 pt-4 text-xs font-semibold uppercase tracking-wider text-muted">{t.navTools}</p>
        </li>
        {TOOLS.map((x) => (
          <li>
            <a href={`/${x.slug}/`} aria-current={x.slug === activeTool ? 'page' : undefined} class="flex min-h-[56px] items-center px-2 text-[17px] font-medium transition-colors hover:text-accent">{x.label}</a>
          </li>
        ))}
        <li>
          <a href={pageHref('how-it-works')} aria-current={path === 'how-it-works' ? 'page' : undefined} class="flex min-h-[56px] items-center px-2 text-[17px] font-medium transition-colors hover:text-accent">{t.navHowItWorks}</a>
        </li>
        <li>
          <a href={pageHref('about')} aria-current={path === 'about' ? 'page' : undefined} class="flex min-h-[56px] items-center px-2 text-[17px] font-medium transition-colors hover:text-accent">{t.navAbout}</a>
        </li>
        <li>
          <a href={pageHref('privacy')} aria-current={path === 'privacy' ? 'page' : undefined} class="flex min-h-[56px] items-center px-2 text-[17px] font-medium transition-colors hover:text-accent">{t.navPrivacy}</a>
        </li>
        <li>
          <a
            href="https://github.com/dusmamud/svgtocode"
            target="_blank"
            rel="noreferrer"
            class="flex min-h-[56px] items-center gap-3 px-2 text-[17px] font-medium transition-colors hover:text-accent"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
            GitHub
          </a>
        </li>
        <li class="px-2 py-4">
          <label class="sr-only" for="locale-select-mobile">{t.languageLabel}</label>
          <select
            id="locale-select-mobile"
            data-locale-select
            aria-label={t.languageLabel}
            class="flex min-h-[48px] w-full cursor-pointer items-center rounded-xl border border-border bg-surface px-3 text-base font-medium text-text"
            data-current={locale}
          >
            {LOCALES.map((l) => (
              <option value={localeUrl(l)} selected={l === locale}>
                {LOCALE_NAMES[l]}
              </option>
            ))}
          </select>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-locale-select]').forEach(function (sel) {
      sel.addEventListener('change', function () {
        window.location.href = sel.value;
      });
    });

    var toggle = document.getElementById('nav-toggle');
    var menu = document.getElementById('mobile-menu');
    var toolsToggle = document.getElementById('nav-tools-toggle');
    var toolsMenu = document.getElementById('nav-tools-menu');

    function setMenu(open) {
      if (!toggle || !menu) return;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      menu.classList.toggle('hidden', !open);
      menu.classList.toggle('flex', open);
      if (open) {
        document.body.dataset.menuScrollY = String(window.scrollY || 0);
        document.body.style.position = 'fixed';
        document.body.style.top = '-' + document.body.dataset.menuScrollY + 'px';
        document.body.style.left = '0';
        document.body.style.right = '0';
      } else {
        var y = parseInt(document.body.dataset.menuScrollY || '0', 10);
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.left = '';
        document.body.style.right = '';
        delete document.body.dataset.menuScrollY;
        window.scrollTo(0, y);
      }
    }

    function setTools(open) {
      if (!toolsToggle || !toolsMenu) return;
      toolsToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toolsMenu.classList.toggle('hidden', !open);
      var chev = document.getElementById('nav-tools-chevron');
      if (chev) chev.classList.toggle('rotate-180', open);
    }

    if (toggle && menu) {
      toggle.addEventListener('click', function () {
        setMenu(toggle.getAttribute('aria-expanded') !== 'true');
      });
      menu.addEventListener('click', function (e) {
        if (e.target.closest('a')) setMenu(false);
      });
      var closeBtn = document.getElementById('mobile-menu-close');
      if (closeBtn) {
        closeBtn.addEventListener('click', function () {
          setMenu(false);
        });
      }
      window.addEventListener('resize', function () {
        if (window.innerWidth >= 1024) setMenu(false);
      });
    }

    if (toolsToggle && toolsMenu) {
      toolsToggle.addEventListener('click', function () {
        setTools(toolsToggle.getAttribute('aria-expanded') !== 'true');
      });
    }

    document.addEventListener('click', function (e) {
      if (toolsMenu && !toolsMenu.classList.contains('hidden')) {
        if (!e.target.closest('#nav-tools-menu') && !e.target.closest('#nav-tools-toggle')) {
          setTools(false);
        }
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        setTools(false);
        setMenu(false);
      }
    });
  })();
</script>
