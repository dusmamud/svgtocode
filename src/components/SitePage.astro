---
import Layout from '../layouts/Layout.astro';
import Converter from '../components/Converter';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getDict, type Dict } from '../i18n/ui';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t: Dict = getDict(locale);
const TOOLS = [
  { slug: 'svg-to-jsx', label: 'SVG → JSX', desc: t.toolJsxDesc },
  { slug: 'svg-to-react', label: 'SVG → React', desc: t.toolReactDesc },
  { slug: 'svg-to-base64', label: 'SVG → Base64', desc: t.toolBase64Desc },
  { slug: 'svg-to-data-uri', label: 'SVG → Data URI', desc: t.toolDataUriDesc },
  { slug: 'svg-optimizer', label: 'SVG Optimizer', desc: t.toolOptimizerDesc },
  { slug: 'svg-to-png', label: 'SVG → PNG', desc: t.toolPngDesc },
];
---

<Layout locale={locale} t={t}>
  <SiteHeader locale={locale} t={t} />

  <main class="mx-auto max-w-6xl px-4 py-8 lg:py-14">
    <div class="mb-6 text-center lg:mb-8">
      <h1 class="mx-auto max-w-3xl text-[clamp(1.8rem,6vw,3.2rem)] font-bold leading-[1.08] tracking-tight">{t.tagline}</h1>
      <p class="mx-auto mt-2 max-w-2xl text-base text-muted">{t.hint}</p>
    </div>

    <Converter t={t} client:load />

    <section class="mx-auto mt-8 max-w-6xl lg:mt-12" aria-labelledby="tools-heading">
      <h2 id="tools-heading" class="text-center text-xl font-bold">{t.toolsHeading}</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:mt-6 lg:grid-cols-3 lg:gap-4">
        {TOOLS.map((x) => (
          <a
            href={`/${x.slug}/`}
            class="rounded-2xl border border-border bg-surface p-5 shadow-[var(--shadow-soft)] transition-colors hover:border-accent"
          >
            <span class="text-[15px] font-semibold">{x.label}</span>
            <p class="mt-1 text-sm text-muted">{x.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mx-auto mt-8 max-w-3xl lg:mt-12" aria-labelledby="how-heading">
      <h2 id="how-heading" class="text-xl font-bold">{t.howTitle}</h2>
      <ol class="mt-4 space-y-3 text-[15px] leading-relaxed text-muted">
        <li class="rounded-2xl border border-border bg-surface p-4 shadow-[var(--shadow-soft)]">
          <span class="me-2 inline-flex h-6 w-6 items-center justify-center rounded-full bg-accent-soft text-xs font-bold text-accent">1</span>
          {t.how1}
        </li>
        <li class="rounded-2xl border border-border bg-surface p-4 shadow-[var(--shadow-soft)]">
          <span class="me-2 inline-flex h-6 w-6 items-center justify-center rounded-full bg-accent-soft text-xs font-bold text-accent">2</span>
          {t.how2}
        </li>
        <li class="rounded-2xl border border-border bg-surface p-4 shadow-[var(--shadow-soft)]">
          <span class="me-2 inline-flex h-6 w-6 items-center justify-center rounded-full bg-accent-soft text-xs font-bold text-accent">3</span>
          {t.how3}
        </li>
      </ol>
    </section>
  </main>

  <SiteFooter locale={locale} t={t} />

</Layout>
